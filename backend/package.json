{
  "name": "@tic/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env ../node_modules/.bin/tsx watch src/server.ts",
    "start": "node --env-file=../.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "prisma:generate": "node --env-file=../.env ../node_modules/.bin/prisma generate",
    "prisma:migrate": "node --env-file=../.env ../node_modules/.bin/prisma migrate dev --name init",
    "prisma:deploy": "node --env-file=../.env ../node_modules/.bin/prisma migrate deploy",
    "db:check": "node --env-file=../.env --import tsx src/infrastructure/database/check-connection.ts",
    "db:bootstrap": "node --env-file=../.env --import tsx src/infrastructure/database/run-bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
