generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnit {
  UN
  KG
  G
  L
  ML
}

enum StockMode {
  SIMPLES
  LOTE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductValueField {
  SALE_PRICE
  COST
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  RETURN_IN
  RETURN_OUT
  REVERSAL_IN
  REVERSAL_OUT
}

enum EntryStatus {
  EM_ANDAMENTO
  CONFIRMADA
  CANCELADA
}

enum InventoryType {
  COMPLETE
  PARTIAL
}

enum InventoryStatus {
  EM_ANDAMENTO
  AGUARDANDO_CONFERENCIA
  CONFIRMADO
  CANCELADO
}

enum CustomerStatus {
  PENDING_PIN
  ACTIVE
  INACTIVE
}

enum LoyaltyMovementType {
  CREDIT
  REDEMPTION
  EXPIRATION
  REVERSAL
  COMPENSATION
}

enum LoyaltyAllocationType {
  CONSUME
  RESTORE
  REVERSE
  COMPENSATE
}

enum AuditActorType {
  USER
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  resetTokenHash String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  sessions     Session[]
  auditLogs    AuditLog[]
  productValueHistory ProductValueHistory[]
  stockMovements StockMovement[]
  entries        Entry[]
  stockLossReasons StockLossReason[]
  inventories      Inventory[]
  createdCustomers Customer[]
  loyaltyPolicies  LoyaltyPolicy[]
  loyaltyMovements LoyaltyMovement[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  action       String        @db.VarChar(100)
  entity       String        @db.VarChar(100)
  entityId     String?       @map("entity_id") @db.VarChar(100)
  beforeData   Json?         @map("before_data")
  afterData    Json?         @map("after_data")
  ipAddress    String?       @map("ip_address") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@index([status])
  @@map("categories")
}

model Product {
  id                       String        @id @default(uuid()) @db.Uuid
  sku                      String        @unique @db.VarChar(40)
  name                     String        @db.VarChar(160)
  description              String?       @db.VarChar(500)
  barcode                  String?       @unique @db.VarChar(50)
  categoryId               String        @map("category_id") @db.Uuid
  unit                     ProductUnit
  cost                     Decimal       @db.Decimal(12, 2)
  salePrice                Decimal       @map("sale_price") @db.Decimal(12, 2)
  minimumStock             Decimal       @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  stockMode                StockMode     @map("stock_mode")
  expirationAlertDays     Int           @default(15) @map("expiration_alert_days")
  status                   ProductStatus @default(ACTIVE)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  category                 Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  valueHistory        ProductValueHistory[]
  stockBalance        StockBalance?
  stockMovements      StockMovement[]
  stockLots           StockLot[]
  entryItems          EntryItem[]
  inventoryItems      InventoryItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductValueHistory {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  field           ProductValueField
  previousValue   Decimal           @map("previous_value") @db.Decimal(12, 2)
  newValue        Decimal           @map("new_value") @db.Decimal(12, 2)
  source          String            @default("MANUAL_EDIT") @db.VarChar(40)
  sourceId        String?           @map("source_id") @db.VarChar(100)
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime          @default(now()) @map("changed_at") @db.Timestamptz(3)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedByUser   User?             @relation(fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, changedAt])
  @@index([changedByUserId])
  @@map("product_value_history")
}

model StockBalance {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("stock_balances")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  reason          String            @db.VarChar(300)
  observations    String?           @db.VarChar(500)
  actorUserId     String            @map("actor_user_id") @db.Uuid
  lotId           String?           @map("lot_id") @db.Uuid
  stockLossReasonId String?          @map("stock_loss_reason_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser       User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lot             StockLot?         @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLossReason StockLossReason?  @relation(fields: [stockLossReasonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([productId, createdAt])
  @@index([actorUserId])
  @@index([lotId])
  @@index([stockLossReasonId])
  @@map("stock_movements")
}

model StockLossReason {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique @db.VarChar(120)
  isActive       Boolean         @default(true) @map("is_active")
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByUser  User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements      StockMovement[]

  @@index([isActive, name])
  @@map("stock_loss_reasons")
}

model StockLot {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  identifier      String          @db.VarChar(120)
  expirationDate  DateTime?       @map("expiration_date") @db.Date
  unitCost        Decimal         @map("unit_cost") @db.Decimal(12, 2)
  initialQuantity Decimal         @map("initial_quantity") @db.Decimal(12, 3)
  currentQuantity Decimal         @map("current_quantity") @db.Decimal(12, 3)
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements       StockMovement[]
  inventoryItems  InventoryItem[]

  @@index([productId, expirationDate, receivedAt])
  @@index([productId, identifier])
  @@map("stock_lots")
}

model Inventory {
  id            String          @id @default(uuid()) @db.Uuid
  type          InventoryType
  status        InventoryStatus @default(EM_ANDAMENTO)
  observations  String?         @db.VarChar(500)
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdById   String          @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         InventoryItem[]

  @@index([status, startedAt])
  @@index([createdById])
  @@map("inventories")
}

model InventoryItem {
  id               String      @id @default(uuid()) @db.Uuid
  inventoryId      String      @map("inventory_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  lotId            String?     @map("lot_id") @db.Uuid
  snapshotQuantity Decimal     @map("snapshot_quantity") @db.Decimal(12, 3)
  countedQuantity  Decimal?    @map("counted_quantity") @db.Decimal(12, 3)
  countedAt        DateTime?   @map("counted_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory        Inventory   @relation(fields: [inventoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lot              StockLot?   @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([inventoryId, productId, lotId])
  @@index([inventoryId, productId])
  @@index([lotId])
  @@map("inventory_items")
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  document    String?        @unique @db.VarChar(14)
  phone       String?        @db.VarChar(30)
  email       String?        @db.VarChar(255)
  notes       String?        @db.VarChar(500)
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries     Entry[]

  @@index([status])
  @@map("suppliers")
}

model Customer {
  id                            String         @id @default(uuid()) @db.Uuid
  name                          String         @db.VarChar(160)
  phone                         String         @unique @db.VarChar(20)
  status                        CustomerStatus @default(PENDING_PIN)
  previousStatus                CustomerStatus? @map("previous_status")
  pinHash                       String?        @map("pin_hash") @db.VarChar(255)
  pinFailedAttempts             Int            @default(0) @map("pin_failed_attempts")
  pinLockedUntil                DateTime?      @map("pin_locked_until") @db.Timestamptz(3)
  pinSetupTokenHash             String?        @unique @map("pin_setup_token_hash") @db.VarChar(64)
  pinSetupTokenExpiresAt        DateTime?      @map("pin_setup_token_expires_at") @db.Timestamptz(3)
  privacyNoticeAcknowledgedAt   DateTime       @map("privacy_notice_acknowledged_at") @db.Timestamptz(3)
  createdById                   String         @map("created_by_id") @db.Uuid
  createdAt                     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                     User           @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions                      CustomerSession[]
  loyaltyCredits                LoyaltyCredit[]
  loyaltyMovements              LoyaltyMovement[]
  loyaltyAllocations            LoyaltyAllocation[]

  @@index([status, name])
  @@index([createdById])
  @@map("customers")
}

model CustomerSession {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId, revokedAt])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model LoyaltyPolicy {
  id                     String   @id @default(uuid()) @db.Uuid
  version                Int      @unique
  pointsPerRealSpent     Int      @map("points_per_real_spent")
  redemptionPointsPerReal Int     @map("redemption_points_per_real")
  isActive               Boolean  @default(true) @map("is_active")
  createdByUserId        String?  @map("created_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUser          User?    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credits                LoyaltyCredit[]

  @@index([isActive, version])
  @@index([createdByUserId, createdAt])
  @@map("loyalty_policies")
}

model LoyaltyCredit {
  id                       String   @id @default(uuid()) @db.Uuid
  customerId               String   @map("customer_id") @db.Uuid
  policyId                 String   @map("policy_id") @db.Uuid
  sourceType               String   @map("source_type") @db.VarChar(40)
  sourceId                 String   @map("source_id") @db.VarChar(100)
  eligibleAmount           Decimal  @map("eligible_amount") @db.Decimal(12, 2)
  pointsGranted            Int      @map("points_granted")
  pointsPerRealSpent       Int      @map("points_per_real_spent")
  redemptionPointsPerReal  Int      @map("redemption_points_per_real")
  expiresAt                DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  policy                   LoyaltyPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creditMovement           LoyaltyMovement?  @relation("LoyaltyCreditMovement")
  reversalMovements        LoyaltyMovement[] @relation("ReversedLoyaltyCredit")
  allocations              LoyaltyAllocation[]

  @@unique([sourceType, sourceId])
  @@unique([id, customerId])
  @@index([customerId, expiresAt, createdAt])
  @@index([policyId])
  @@map("loyalty_credits")
}

model LoyaltyMovement {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String              @map("customer_id") @db.Uuid
  type              LoyaltyMovementType
  pointsDelta       Int                 @map("points_delta")
  redemptionValueCents BigInt?            @map("redemption_value_cents")
  sourceType        String              @map("source_type") @db.VarChar(40)
  sourceId          String?             @map("source_id") @db.VarChar(100)
  reason            String?             @db.VarChar(300)
  creditId          String?             @unique @map("credit_id") @db.Uuid
  reversalOfId      String?             @map("reversal_of_id") @db.Uuid
  reversalOfCreditId String?            @map("reversal_of_credit_id") @db.Uuid
  actorUserId       String?             @map("actor_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credit            LoyaltyCredit?      @relation("LoyaltyCreditMovement", fields: [creditId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversalOf        LoyaltyMovement?   @relation("LoyaltyMovementReversals", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversals         LoyaltyMovement[]   @relation("LoyaltyMovementReversals")
  reversalOfCredit  LoyaltyCredit?      @relation("ReversedLoyaltyCredit", fields: [reversalOfCreditId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser         User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocations       LoyaltyAllocation[]

  @@unique([sourceType, sourceId, type])
  @@unique([id, customerId])
  @@index([customerId, createdAt])
  @@index([type, createdAt])
  @@index([reversalOfId])
  @@index([actorUserId])
  @@map("loyalty_movements")
}

model LoyaltyAllocation {
  id          String                 @id @default(uuid()) @db.Uuid
  movementId  String                 @map("movement_id") @db.Uuid
  creditId    String                 @map("credit_id") @db.Uuid
  customerId  String                 @map("customer_id") @db.Uuid
  type        LoyaltyAllocationType
  points      Int
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movement    LoyaltyMovement        @relation(fields: [movementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credit      LoyaltyCredit          @relation(fields: [creditId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([movementId, creditId, type])
  @@index([creditId, createdAt])
  @@map("loyalty_allocations")
}

model Entry {
  id          String      @id @default(uuid()) @db.Uuid
  supplierId  String?     @map("supplier_id") @db.Uuid
  createdById String      @map("created_by_id") @db.Uuid
  status      EntryStatus @default(EM_ANDAMENTO)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items       EntryItem[]

  @@index([status, createdAt])
  @@index([supplierId])
  @@map("entries")
}

model EntryItem {
  id               String    @id @default(uuid()) @db.Uuid
  entryId          String    @map("entry_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  position         Int       @default(0)
  quantity         Decimal   @db.Decimal(12, 3)
  unitCost         Decimal   @map("unit_cost") @db.Decimal(12, 2)
  lotIdentifier    String?   @map("lot_identifier") @db.VarChar(120)
  expirationDate   DateTime? @map("expiration_date") @db.Date
  entry            Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entryId, position])
  @@index([productId])
  @@map("entry_items")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}
