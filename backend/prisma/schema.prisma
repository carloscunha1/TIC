generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnit {
  UN
  KG
  G
  L
  ML
}

enum StockMode {
  SIMPLES
  LOTE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductValueField {
  SALE_PRICE
  COST
}

enum AuditActorType {
  USER
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  resetTokenHash String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  sessions     Session[]
  auditLogs    AuditLog[]
  productValueHistory ProductValueHistory[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  action       String        @db.VarChar(100)
  entity       String        @db.VarChar(100)
  entityId     String?       @map("entity_id") @db.VarChar(100)
  beforeData   Json?         @map("before_data")
  afterData    Json?         @map("after_data")
  ipAddress    String?       @map("ip_address") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@index([status])
  @@map("categories")
}

model Product {
  id                       String        @id @default(uuid()) @db.Uuid
  sku                      String        @unique @db.VarChar(40)
  name                     String        @db.VarChar(160)
  description              String?       @db.VarChar(500)
  barcode                  String?       @unique @db.VarChar(50)
  categoryId               String        @map("category_id") @db.Uuid
  unit                     ProductUnit
  cost                     Decimal       @db.Decimal(12, 2)
  salePrice                Decimal       @map("sale_price") @db.Decimal(12, 2)
  minimumStock             Decimal       @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  stockMode                StockMode     @map("stock_mode")
  expirationAlertDays     Int           @default(15) @map("expiration_alert_days")
  status                   ProductStatus @default(ACTIVE)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  category                 Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  valueHistory        ProductValueHistory[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductValueHistory {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  field           ProductValueField
  previousValue   Decimal           @map("previous_value") @db.Decimal(12, 2)
  newValue        Decimal           @map("new_value") @db.Decimal(12, 2)
  source          String            @default("MANUAL_EDIT") @db.VarChar(40)
  sourceId        String?           @map("source_id") @db.VarChar(100)
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime          @default(now()) @map("changed_at") @db.Timestamptz(3)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedByUser   User?             @relation(fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, changedAt])
  @@index([changedByUserId])
  @@map("product_value_history")
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  document    String?        @unique @db.VarChar(14)
  phone       String?        @db.VarChar(30)
  email       String?        @db.VarChar(255)
  notes       String?        @db.VarChar(500)
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("suppliers")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}
