generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditActorType {
  USER
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  resetTokenHash String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  action       String        @db.VarChar(100)
  entity       String        @db.VarChar(100)
  entityId     String?       @map("entity_id") @db.VarChar(100)
  beforeData   Json?         @map("before_data")
  afterData    Json?         @map("after_data")
  ipAddress    String?       @map("ip_address") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}
